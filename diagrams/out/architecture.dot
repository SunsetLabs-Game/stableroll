digraph "architecture" {
  bgcolor="transparent";
  fontname="Helvetica";
  fontsize="13";
  fontcolor="#1E293B";
  labelloc="t";
  labeljust="l";
  pad="0.7";
  nodesep="0.55";
  ranksep="0.8";
  rankdir="TB";
  splines="spline";
  size="14,11";
  label=<<B>StableRoll - System Architecture</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">A company funds a payroll run once on Starknet · recipients claim on Starknet, EVM, or Solana · no on-chain payer↔recipient link</FONT>>;
  node [shape="box", style="filled,rounded", fillcolor="#F8FAFC", color="#64748B", fontname="Helvetica", fontsize="11", fontcolor="#1E293B", margin="0.22,0.13", penwidth="1.6"];
  edge [color="#94A3B8", fontname="Helvetica", fontsize="10", fontcolor="#475569", arrowsize="0.85", penwidth="1.4"];
  subgraph cluster_pool {
    label=<<B>STRK20 Privacy Pool</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Shielded notes · InvokeExternal is the only caller of Payroll</FONT>>;
    style="rounded";
    color="#9333EA";
    fontcolor="#9333EA";
    fontname="Helvetica";
    fontsize="12";
    penwidth="2.5";
    margin="18";
    pool [label=<<B>Privacy Pool</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Mainnet 0x0403…812a</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">InvokeExternal after a verified STARK proof</FONT>>, fillcolor="#FAF5FF", color="#9333EA", penwidth="2"];
  }
  subgraph cluster_payroll {
    label=<<B>Payroll helper  -  privacy_invoke</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Aggregate accounting · no payer address stored</FONT>>;
    style="rounded";
    color="#16A34A";
    fontcolor="#16A34A";
    fontname="Helvetica";
    fontsize="12";
    penwidth="2.5";
    margin="18";
    openfund [label=<<B>OpenRun / FundCommitment</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">privacy_invoke, called only by the pool</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">owner_secret proves run ownership</FONT>>, fillcolor="#F0FDF4", color="#16A34A", penwidth="2.5"];
    runinfo [label=<<B>RunInfo</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">expected_count · expected_total · closed</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">owner_commitment (secret-proven) · no payer address</FONT>>, fillcolor="#F0FDF4", color="#16A34A"];
    claimop [label=<<B>Claim</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Recipient reveals the commitment secret</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Hash is recomputed on-chain · never passed in</FONT>>, fillcolor="#F0FDF4", color="#16A34A", penwidth="2"];
  }
  subgraph cluster_claim {
    label=<<B>Claim legs</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Downstream of a Starknet Claim · never custody</FONT>>;
    style="rounded";
    color="#3B82F6";
    fontcolor="#3B82F6";
    fontname="Helvetica";
    fontsize="12";
    penwidth="2.5";
    margin="18";
    starknet [label=<<B>Starknet wallet</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Pool payout into an open note</FONT>>, fillcolor="#EFF6FF", color="#3B82F6"];
    evm [label=<<B>EVM wallet</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">privacy-bridge cashOut</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Wired · not live-exercised</FONT>>, fillcolor="#EFF6FF", color="#3B82F6"];
    solana [label=<<B>Solana wallet</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">NEAR Intents 1-Click connector</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Live-quoted · e2e claim not exercised</FONT>>, fillcolor="#FFFBEB", color="#D97706"];
  }
  payer [label=<<B>Payer</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Holds owner_secret off-chain</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Opens the run · funds each commitment</FONT>>, fillcolor="#F0F9FF", color="#0284C7", penwidth="2"];
  payer -> pool [color="#94A3B8", label="fund (shielded)"];
  pool -> openfund [color="#059669", label="InvokeExternal", fontcolor="#059669", penwidth="2"];
  openfund -> runinfo [color="#94A3B8"];
  runinfo -> claimop [color="#94A3B8", label="recipient holds\ncommitment secret"];
  claimop -> starknet [color="#94A3B8"];
  claimop -> evm [color="#94A3B8"];
  claimop -> solana [color="#D97706", fontcolor="#D97706"];
}
