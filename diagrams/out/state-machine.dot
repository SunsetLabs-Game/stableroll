digraph "state-machine" {
  bgcolor="transparent";
  fontname="Helvetica";
  fontsize="13";
  fontcolor="#1E293B";
  labelloc="t";
  labeljust="l";
  pad="0.7";
  nodesep="0.55";
  ranksep="0.8";
  rankdir="TB";
  splines="spline";
  size="12,14";
  label=<<B>StableRoll - Payroll Run State Machine</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">expected_count and expected_total are fixed at OpenRun · closed only when every promised recipient is funded at the promised total</FONT>>;
  node [shape="box", style="filled,rounded", fillcolor="#F8FAFC", color="#64748B", fontname="Helvetica", fontsize="11", fontcolor="#1E293B", margin="0.22,0.13", penwidth="1.6"];
  edge [color="#94A3B8", fontname="Helvetica", fontsize="10", fontcolor="#475569", arrowsize="0.85", penwidth="1.4"];
  start [label="", width="0.3", height="0.3", fixedsize="true", fillcolor="#F8FAFC", color="#64748B", shape="circle"];
  open [label=<<B>OpenRun</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Fixes expected_count and expected_total</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Rejects either = 0 · run_id = compute_run_id(owner_secret)</FONT>>, fillcolor="#F0F9FF", color="#0284C7", penwidth="2"];
  fund [label=<<B>FundCommitment</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Must prove owner_secret (NOT_RUN_OWNER otherwise)</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Token must match the run · increments funded_count</FONT>>, fillcolor="#F0FDF4", color="#16A34A", penwidth="2"];
  last [label=<<B>Last slot?</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">funded_count == expected_count</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">AND total_committed == expected_total</FONT>>, fillcolor="#FFFBEB", color="#D97706", shape="diamond", penwidth="2"];
  closed [label=<<B>closed = true</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Run is fully funded at the promised budget</FONT>>, fillcolor="#ECFDF5", color="#059669", penwidth="2"];
  under [label=<<B>UNDER_COMMITTED</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Final FundCommitment shorts the budget</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">Payer cannot hide an underpayment</FONT>>, fillcolor="#FEF2F2", color="#DC2626", penwidth="2"];
  omit [label=<<B>Omitted recipient</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">funded_count never reaches expected_count</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">closed stays false · is_complete can never be true</FONT>>, fillcolor="#FEF2F2", color="#DC2626", penwidth="2"];
  claim [label=<<B>Claim</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Secret preimage recomputes the commitment hash</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">paid_count and total_paid increment</FONT>>, fillcolor="#EFF6FF", color="#3B82F6", penwidth="2"];
  complete [label=<<B>is_complete</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">closed AND paid_count == expected_count</FONT><BR/><FONT POINT-SIZE="9" COLOR="#475569">AND total_paid == total_committed</FONT>>, fillcolor="#ECFDF5", color="#059669", penwidth="3"];
  start -> open [color="#94A3B8", style="invis"];
  open -> fund [color="#94A3B8"];
  fund -> fund [color="#94A3B8", label="more slots remain"];
  fund -> last [color="#94A3B8", label="attempt final slot"];
  last -> closed [color="#059669", label="totals match", fontcolor="#059669", penwidth="2"];
  last -> under [color="#DC2626", label="short the last", fontcolor="#DC2626"];
  fund -> omit [color="#DC2626", label="never fund a promised recipient", fontcolor="#DC2626", style="dashed"];
  closed -> claim [color="#94A3B8"];
  claim -> complete [color="#059669", label="every funded commitment claimed", fontcolor="#059669", penwidth="2"];
}
