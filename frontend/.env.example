# Copy to .env.local and fill in. Placeholders only — never commit real values.
#
# None of these are required for the tokenless build/test path. Without them
# the admin page renders a clearly-labelled "Cavos not configured" state
# instead of throwing (see frontend/src/lib/cavos-config.ts).
#
# NEXT_PUBLIC_* reaches the browser bundle. Never put a private key, viewing
# key, or session secret behind that prefix — these four are public client
# identifiers, not secrets.

# App ID and salt from the Cavos dashboard, per deployment.
NEXT_PUBLIC_CAVOS_APP_ID=
# Must stay stable once set. In @cavos/kit v0.1.11 the salt no longer enters the
# wallet address — it names the device-key slot — so changing it does not move
# anyone to a new account, but every returning device generates a new key and
# lands in `needs-device-approval`: the app keeps working while every user is
# locked out until they re-approve. `checkAppSaltDrift` exists for exactly this.
NEXT_PUBLIC_CAVOS_APP_SALT=

# "mainnet" or "testnet". Defaults to mainnet if unset — the sprint is
# mainnet-only, so leave this unset in production rather than setting it to
# testnet by habit.
NEXT_PUBLIC_CAVOS_NETWORK=mainnet
# "production" or "development". Defaults to production if unset.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=production

# Paymaster key. @cavos/kit's own types call this "Required for Starknet" — it
# sponsors the wallet deploy and every execute, so without it a signed-in user
# gets an account that cannot transact.
#
# This one is NOT merely a public identifier, unlike the four above. The SDK
# consuming it runs in the browser, so it necessarily ships in the bundle and
# anyone can read it out and spend against the sponsorship budget. Cap and scope
# it in the Cavos dashboard, and rotate it if it ever pays for something you do
# not recognise.
NEXT_PUBLIC_CAVOS_PAYMASTER_API_KEY=

# Public origin of this deployment, used to build the OAuth callback
# (`<origin>/auth/callback`). Leave unset locally and on previews: the SDK then
# infers the callback itself, which is what you want when the origin changes per
# deployment. The value must be allow-listed in the Cavos dashboard.
NEXT_PUBLIC_SITE_URL=
