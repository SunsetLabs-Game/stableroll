# Copy to .env.local and fill in. Placeholders only — never commit real values.
#
# None of these are required for the tokenless build/test path. Without them
# the admin page renders a clearly-labelled "Cavos not configured" state
# instead of throwing (see frontend/src/lib/cavos-config.ts).
#
# NEXT_PUBLIC_* reaches the browser bundle. Never put a private key, viewing
# key, or session secret behind that prefix — these four are public client
# identifiers, not secrets.

# App ID and salt from the Cavos dashboard, per deployment.
NEXT_PUBLIC_CAVOS_APP_ID=
# Must stay stable once set: wallet addresses derive from it, so changing it
# silently moves every user to a different account.
NEXT_PUBLIC_CAVOS_APP_SALT=

# "mainnet" or "testnet". Defaults to mainnet if unset — the sprint is
# mainnet-only, so leave this unset in production rather than setting it to
# testnet by habit.
NEXT_PUBLIC_CAVOS_NETWORK=mainnet
# "production" or "development". Defaults to production if unset.
NEXT_PUBLIC_CAVOS_ENVIRONMENT=production
