# Copy to .env and fill in. Placeholders only — never commit real values.
#
# None of these are required for the tokenless path (`npm run test:offline`,
# `snforge test`). They gate the credentialed suite (`npm test`) and the
# on-chain eligibility check (`npm run verify:eligibility`, which only needs
# MAINNET_RPC_URL — see that section below).

# --- Mainnet (read-only; verify:eligibility) --------------------------------

# Overrides the default public RPC (https://rpc.starknet.lava.build) if it
# rate-limits. Not required otherwise. See docs/mainnet-eligibility.md.
MAINNET_RPC_URL=

# --- Sepolia network config (integration/src/config.ts) ---------------------

SEPOLIA_RPC_URL=
# The STRK20 privacy pool address on Sepolia.
SEPOLIA_POOL_ADDRESS=
# Payroll contract address on Sepolia (from its own declare+deploy).
SEPOLIA_PAYROLL_ADDRESS=
# ERC-20 token address the test run is denominated in (Sepolia STRK). Must be
# a real felt address, not a symbol like "STRK" — see config.ts's comment.
SEPOLIA_STRK_ADDRESS=
# Hosted Sepolia proving-service URL. No publicly documented hosted Sepolia
# prover URL exists (see task-4-report.md) — this must come from whoever has
# access to StarkWare's hosted Sepolia infrastructure, or a self-hosted
# starknet_transaction_prover instance. Do not guess a value here.
SEPOLIA_PROVING_SERVICE_URL=

# --- Test/funder account (used across most credentialed tests) --------------

TEST_ACCOUNT_ADDRESS=
TEST_ACCOUNT_PRIVATE_KEY=
# Funder's Privacy SDK viewing key (integration/src/config.ts's getTransfers).
TEST_VIEWING_KEY=
# EIP-712-style signature the EVM claim leg resolves for the bridge cash-out
# (claim-evm.test.ts). Test-fixture only.
TEST_ACCOUNT_SIGNATURE=
# Commitment secret for fund-run.test.ts. Optional — defaults to
# "task-4-fund-run-secret" if unset.
TEST_COMMITMENT_SECRET=

# --- Run/commitment fixtures for the claim tests -----------------------------
# (claim-evm.test.ts, claim-solana.test.ts, fund-run.test.ts)

SEPOLIA_RUN_ID=
SEPOLIA_RUN_OWNER_SECRET=
SEPOLIA_COMMITMENT_SECRET=
SEPOLIA_CLAIM_NOTE_ID=
SEPOLIA_CLAIM_AMOUNT=

# --- Registered recipient (claim-registered.test.ts) -------------------------

RECIPIENT_ACCOUNT_ADDRESS=
RECIPIENT_ACCOUNT_PRIVATE_KEY=
RECIPIENT_VIEWING_KEY=

# --- Unregistered recipient (claim-unregistered.test.ts) ---------------------
# A wallet that has never registered a viewing key with the pool, to exercise
# the NOT_REGISTERED path.

UNREGISTERED_ACCOUNT_ADDRESS=
UNREGISTERED_ACCOUNT_PRIVATE_KEY=
UNREGISTERED_VIEWING_KEY=

# --- EVM claim leg (claim-evm.test.ts) ---------------------------------------

# Base Sepolia address the claimed funds are cashed out to via CCTP.
BASE_SEPOLIA_DESTINATION_ADDRESS=

# claim-evm.test.ts also reads BRIDGE_-prefixed vars, consumed dynamically via
# @starkware-libs/starknet-privacy-bridge's bridgeEnvFromRecord(process.env,
# "BRIDGE_") — e.g. BRIDGE_ADMIN_ADDRESS / BRIDGE_ADMIN_PRIVATE_KEY for its
# dev/testnet admin-funded path (verified against that package's
# packages/bridge-core/src/core/config.ts). That package is early and still
# evolving (see CLAUDE.md and docs/evm-claim-coverage.md) — read its current
# config.ts for the full set before relying on this test; not enumerated here
# to avoid documenting a list that goes stale.

# --- Solana claim leg (claim-solana.test.ts) ---------------------------------

SOLANA_TEST_RECIPIENT=

# --- NEAR Intents connector (near-intents-connector.ts) ----------------------

NEAR_INTENTS_API_KEY=
# Basis points, e.g. 100 = 1%. Optional — defaults to 100 if unset.
NEAR_INTENTS_SLIPPAGE_BPS=
# Optional — defaults to 30 if unset.
NEAR_INTENTS_DEADLINE_MINUTES=
# Optional — defaults to Solana USDC's asset id (deepest liquidity) if unset.
NEAR_INTENTS_DEST_ASSET=
# Starknet address funds are refunded to if a NEAR Intents swap fails. Choose
# this deliberately — it decides where money lands on failure.
STARKNET_REFUND_ADDRESS=
